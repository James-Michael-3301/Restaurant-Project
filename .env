# Copy this file to .env and fill it in
PORT=3000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/mangan-tamu
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mangan-tamu?retryWrites=true&w=majority

# Needed for POST / PUT / DELETE. Sent as the x-admin-key header.
# Leave empty to disable write routes entirely.
ADMIN_KEY=change-me

# Fixes "querySrv ECONNREFUSED" on networks that block SRV DNS lookups.
# Uncomment to use Google and Cloudflare DNS for the MongoDB connection:
# DNS_SERVERS=8.8.8.8,1.1.1.1
